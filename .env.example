# Live publishing is off unless this is exactly "true".
PUBLISHING_ENABLED=false

# Ayrshare (posting backend). Without a key the tool stays in dry-run mode.
AYRSHARE_API_KEY=
# Only needed on Ayrshare Business plans when posting for a specific brand profile.
AYRSHARE_PROFILE_KEY=

# Queue storage. Without these the CLI falls back to an in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# How often the worker checks for due posts (seconds, minimum 30).
WORKER_INTERVAL_SECONDS=300
