# Live publishing is off unless this is exactly "true".
PUBLISHING_ENABLED=false

# --- LinkedIn Company Page (direct) --- see docs/CREDENTIALS.md
# Needs Community Management API access and a page admin token.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=202606

# --- Facebook Page (direct) --- see docs/CREDENTIALS.md
# Page access token, not a user token.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_GRAPH_VERSION=v21.0

# --- Optional aggregator (Ayrshare) ---
# Covers any platform without direct credentials, e.g. X and Instagram.
AYRSHARE_API_KEY=
AYRSHARE_PROFILE_KEY=

# Queue storage. Without these the CLI falls back to an in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# How often the worker checks for due posts (seconds, minimum 30).
WORKER_INTERVAL_SECONDS=300
